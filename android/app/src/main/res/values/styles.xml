<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fundo claro na barra de status: a janela vai de borda a borda, entao
         o FrameLayout raiz (cor #F4F7F6) aparece na faixa da barra de status.
         windowLightStatusBar=true deixa os icones do sistema escuros/legiveis. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F4F7F6</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F4F7F6</item>
        <item name="android:windowBackground">#F4F7F6</item>
    </style>
</resources>
